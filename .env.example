# ── LLM ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bfsi_user:secret@localhost:5432/bfsi_credit
POSTGRES_USER=bfsi_user
POSTGRES_PASSWORD=secret
POSTGRES_DB=bfsi_credit

# ── Redis & Kafka ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_DOCUMENTS=loan.documents.raw
KAFKA_TOPIC_DECISIONS=loan.decisions

# ── MLflow ───────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=bfsi-credit-scoring

# ── MCP Servers ──────────────────────────────────────────────────
BUREAU_MCP_PORT=9001
BANK_TXN_MCP_PORT=9002
GST_MCP_PORT=9003
RBI_COMPLIANCE_MCP_PORT=9004
PENNY_DROP_MCP_PORT=9005

# ── Auth ─────────────────────────────────────────────────────────
SECRET_KEY=your-bfsi-secret-key-min-32-chars
ALGORITHM=HS256

# ── AWS ──────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET_DOCS=bfsi-loan-documents

# ── Security (BFSI Grade) ─────────────────────────────────────────
ENCRYPTION_KEY=your-aes-256-key-base64-encoded
ENABLE_PII_MASKING=true
AUDIT_LOG_BUCKET=bfsi-audit-logs
DPDP_COMPLIANCE_MODE=true

# ── Observability ────────────────────────────────────────────────
LANGSMITH_API_KEY=ls__...
SENTRY_DSN=https://...
LOG_LEVEL=INFO
ENVIRONMENT=development
